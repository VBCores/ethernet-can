{
    "spellright.language": [
        "ru",
        "en"
    ],
    "spellright.documentTypes": [
        "markdown",
        "latex",
        "plaintext"
    ],
    // Оптимизации
    "files.exclude": {
        "**/__pycache__/**": true,
        "**/tmp/**": true,
        "**/node_modules/**": true,
        "**/.git/objects/**": true,
        "**/build/**": true,
        "**/log/**": true,
        "**/repo.key**": true,
        "**/.DS_Store": true,
        "**/.git": true,
        "**/.vs": true,
        "**/.vsconfig": true,
        "**/*.booproj": true,
        "**/*.pidb": true,
        "**/*.suo": true,
        "**/*.user": true,
        "**/*.userprefs": true,
        "**/*.unityproj": true,
        "**/*.dll": true,
        "**/*.exe": true,
        "**/*.pdf": true,
        "**/*.mid": true,
        "**/*.midi": true,
        "**/*.wav": true,
        "**/*.gif": true,
        "**/*.ico": true,
        "**/*.jpg": true,
        "**/*.jpeg": true,
        "**/*.psd": true,
        "**/*.tga": true,
        "**/*.tif": true,
        "**/*.tiff": true,
        "**/*.3ds": true,
        "**/*.3DS": true,
        "**/*.fbx": true,
        "**/*.FBX": true,
        "**/*.lxo": true,
        "**/*.LXO": true,
        "**/*.ma": true,
        "**/*.MA": true,
        "**/*.obj": true,
        "**/*.OBJ": true,
        "**/*.asset": true,
        "**/*.cubemap": true,
        "**/*.flare": true,
        "**/*.mat": true,
        "**/*.meta": true,
        "**/*.prefab": true,
        "**/*.unity": true,
        "build/": true,
        "Build/": true,
        "Library/": true,
        "library/": true,
        "obj/": true,
        "Obj/": true,
        "Logs/": true,
        "logs/": true,
        "ProjectSettings/": true,
        "UserSettings/": true,
        "temp/": true,
        "Temp/": true
    },
    "files.watcherExclude": {
        "**/hosts/nas/**": true,
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/node_modules/**": true,
        "**/tmp/**": true,
        "**/dist/**": true,
        "**/devel/**": true,
        "**/build/**": true
    },
    "search.exclude": {
        "**/hosts/nas/**": true,
        "**/node_modules/**": true,
        "**/dist/**": true,
        "**/tmp/**": true,
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true
    },
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "files.trimTrailingWhitespace": true,
    "spellright.ignoreFiles": [
        "**/.gitignore",
        "**/.spellignore"
    ],
    "spellright.parserByClass": {
        "dsdl": {
            "parser": "code"
        }
    },
    "C_Cpp.files.exclude": {
        "**/hosts/**": true,
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/node_modules/**": true,
        "**/tmp/**": true,
        "**/dist/**": true,
        "**/devel/**": true,
        "**/build/**": true,
        "**/.vscode": true,
        "**/.vs": true
    },
    "C_Cpp.codeAnalysis.exclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/node_modules/**": true,
        "**/tmp/**": true,
        "**/dist/**": true,
        "**/devel/**": true,
        "**/build/**": true,
        "**/.vscode": true,
        "**/.vs": true
    },
    "C_Cpp.intelliSenseMemoryLimit": 4096,
    "ruff.lineLength": 120,
    "[python]": {
        "diffEditor.ignoreTrimWhitespace": false,
        "editor.formatOnType": false,
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.wordBasedSuggestions": "matchingDocuments"
    },
    "python.analysis.extraPaths": [

    ],
    "python.analysis.include": [
        "${workspaceFolder}/*.py",
        "${workspaceFolder}/**/*.py"
    ],
    "ruff.exclude": [
        "**/node_modules",
        "**/__pycache__",
        "**/.*",
        ".venv"
    ],
    "python.analysis.indexing": true,
    "python.analysis.exclude": [
        "**/node_modules",
        "**/__pycache__",
        "**/.*",
        ".venv"
    ],
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.patterns": {
        "*.sln": "*.csproj",
        "*.slnx": "*.csproj"
    },
}
